<%- include('partials-head',{title:center.name}) %><section class="detail-hero"><div><span class="eyebrow"><%= center.city.toUpperCase() %></span><h1><%= center.name %></h1><% if(center.rating){ %><div class="big-rating">★ <%= center.rating %> <span>(<%= center.reviews %> public reviews at lookup time)</span></div><% } else { %><div class="big-rating">Rating not verified</div><% } %><p><%= center.description %></p><p>📍 <%= center.address %></p><p class="muted">Map pin is an approximate area pin; use the address link below for directions.</p><div class="actions"><% if(user){ %><form action="/favorite/<%= center.id %>" method="post"><button class="button"><%= favorite?'♥ Saved':'♡ Save center' %></button></form><% } else { %><a class="button" href="/login">Login to save</a><% } %><a class="outline" href="#courses">View courses</a></div></div><img src="<%= center.image_url %>" alt="<%= center.name %>"></section><section class="detail-grid"><div><section class="panel" id="courses"><h2>Courses offered</h2><div class="course-table"><div class="course-row head"><b>Course</b><b>Category</b><b>Duration</b><b>Fee</b><b>Mode</b></div><% courses.forEach(c=>{ %><div class="course-row"><span><strong><%= c.name %></strong></span><span><%= c.category %></span><span><%= c.duration %></span><span><%= c.fee %></span><span><%= c.mode %></span></div><% }) %></div></section><section class="panel"><h2>Facilities</h2><div class="chips"><% (center.facilities||[]).forEach(f=><span><%= f %></span>) %></div></section></div><aside><div class="panel contact"><h2>Institute information</h2><p>📞 <%= center.phone %></p><p>✉️ <%= center.email %></p><p>💰 <%= center.fee_range %></p><% if(center.website){ %><a href="<%= center.website %>" target="_blank" rel="noopener">Official website →</a><% } %><a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(center.address) %>" target="_blank" rel="noopener">Open address in Google Maps →</a></div><div id="detailMap"></div></aside></section><script>window.centerLocation={lat:<%= center.latitude %>,lng:<%= center.longitude %>,name:<%- JSON.stringify(center.name) %>};</script><script src="/map.js"></script><%- include('partials-foot') %>
