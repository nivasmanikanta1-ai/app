<%- include('partials-head',{title:'Search Training Centers'}) %><section class="page-head"><span class="eyebrow">SEARCH</span><h1>Training centers</h1><p>Find institutes by course, category or city.</p></section><form action="/search" class="filterbar"><input name="q" value="<%= q %>" placeholder="Course or institute"><input name="city" value="<%= city %>" placeholder="City"><select name="category"><option value="">All categories</option><option value="Cloud" <%= category==='Cloud'?'selected':'' %>>Cloud</option><option value="DevOps" <%= category==='DevOps'?'selected':'' %>>DevOps</option><option value="Development" <%= category==='Development'?'selected':'' %>>Development</option><option value="Data" <%= category==='Data'?'selected':'' %>>Data</option><option value="Programming" <%= category==='Programming'?'selected':'' %>>Programming</option><option value="Security" <%= category==='Security'?'selected':'' %>>Security</option></select><button>Search</button></form><section class="results-layout"><div><p class="muted"><%= centers.length %> center(s) found</p><div class="list"><% centers.forEach(c=>{ %><article class="result"><img src="<%= c.image_url %>" alt=""><div><div class="rating"><% if(c.rating){ %>★ <%= c.rating %> · <%= c.reviews %> public reviews<% } else { %>Rating not verified<% } %></div><h2><a href="/center/<%= c.id %>"><%= c.name %></a></h2><p class="muted">📍 <%= c.address %></p><p><%= c.description %></p><p><strong>Fees:</strong> <%= c.fee_range %></p><a class="outline" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(c.address) %>" target="_blank" rel="noopener">Open map</a><a class="outline" href="/center/<%= c.id %>">View institute</a></div></article><% }) %><% if(!centers.length){ %><div class="empty"><h2>No matching centers</h2><p>Try a different course or city.</p></div><% } %></div></div><div id="searchMap"></div></section><script src="/map.js"></script><script>window.searchMap=true;</script><%- include('partials-foot') %>
