<%- include('partials-head',{title:'Find Training Centers'}) %><section class="hero"><div><span class="eyebrow">LEARN · GROW · GET HIRED</span><h1>Find the right training center for your career.</h1><p>Search courses, compare institutes, view facilities and explore centers on the map.</p><form action="/search" class="searchbox"><input name="q" placeholder="Search course or training center"><input name="city" placeholder="City e.g. Hyderabad"><button>Search</button></form><div class="quick"><span>Popular:</span><a href="/search?category=Cloud">AWS / Cloud</a><a href="/search?category=DevOps">DevOps</a><a href="/search?category=Development">Full Stack</a><a href="/search?category=Data">Data</a></div></div><div class="hero-card"><div class="stat"><b><%= courseCount %></b><span>Listed courses</span></div><div class="stat"><b><%= categoryCount %></b><span>Course categories</span></div><div class="stat"><b><%= centerCount %></b><span>Training centers</span></div></div></section><section class="section"><div class="section-head"><div><span class="eyebrow">DISCOVER</span><h2>Featured training centers</h2></div><a href="/search">View all →</a></div><div class="grid"><% featured.forEach(c=>{ %><article class="card"><img src="<%= c.image_url %>" alt="<%= c.name %>"><div class="card-body"><div class="rating">★ <%= c.rating %> <small>(<%= c.reviews %> reviews)</small></div><h3><a href="/center/<%= c.id %>"><%= c.name %></a></h3><p class="muted">📍 <%= c.city %> · <%= c.fee_range %></p><p><%= c.description.substring(0,120) %>...</p><% if(c.website){ %><a class="outline" href="<%= c.website %>" target="_blank" rel="noopener">Official site</a><% } %><a class="outline" href="/center/<%= c.id %>">View details</a></div></article><% }) %></div></section><section class="map-section"><div><span class="eyebrow">EXPLORE LOCATIONS</span><h2>Find centers near you</h2><p>Use the interactive map to explore training centers across major cities.</p><a class="button" href="/search">Explore all centers</a></div><div id="homeMap"></div></section><script src="/map.js"></script><%- include('partials-foot') %>
