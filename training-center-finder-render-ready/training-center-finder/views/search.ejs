<%- include('partials-head',{title:'Search Training Centers'}) %>
<section class="page-head"><span class="eyebrow">SEARCH</span><h1>Training centers</h1>
<p>Search by city, institute or course.</p></section>
<form action="/search" class="filterbar">
<input name="q" value="<%= q %>" placeholder="Course or institute">
<input name="city" value="<%= city %>" placeholder="City">
<select name="category">
<option value="">All categories</option>
<option value="Cloud" <%= category==='Cloud'?'selected':'' %>>Cloud</option>
<option value="DevOps" <%= category==='DevOps'?'selected':'' %>>DevOps</option>
<option value="Development" <%= category==='Development'?'selected':'' %>>Development</option>
<option value="Data" <%= category==='Data'?'selected':'' %>>Data</option>
<option value="Programming" <%= category==='Programming'?'selected':'' %>>Programming</option>
<option value="Security" <%= category==='Security'?'selected':'' %>>Security</option>
</select><button>Search</button></form>
<p class="muted"><%= centers.length %> center(s) found</p>
<div class="list">
<% centers.forEach(c=>{ %>
<article class="result">
<div>
<h2><a href="/center/<%= c.id %>"><%= c.name %></a></h2>
<a class="outline" href="/center/<%= c.id %>">View institute</a>
</div>
</article>
<% }) %>
<% if(!centers.length){ %><div class="empty"><h2>No matching centers</h2><p>Try another city or course.</p></div><% } %>
</div>
<%- include('partials-foot') %>