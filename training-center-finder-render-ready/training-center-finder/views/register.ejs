<%- include('partials-head',{title:'Register'}) %>
<section class="auth"><div class="auth-card"><span class="eyebrow">JOIN</span><h1>Create account</h1>
<% if(error){ %><div class="alert"><%= error %></div><% } %>
<form method="post" action="/register">
<label>Name<input name="name" required></label>
<label>Email<input type="email" name="email" required></label>
<label>Password<input type="password" name="password" minlength="6" required></label>
<button class="button full">Create account</button></form>
<p>Already registered? <a href="/login">Sign in</a></p></div></section>
<%- include('partials-foot') %>