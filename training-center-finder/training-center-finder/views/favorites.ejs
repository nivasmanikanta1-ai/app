<%- include('partials-head',{title:'Saved Centers'}) %><section class="page-head"><span class="eyebrow">YOUR SHORTLIST</span><h1>Saved training centers</h1><p>Quickly return to institutes you want to compare.</p></section><section class="grid"><% centers.forEach(c=>{ %><article class="card"><img src="<%= c.image_url %>" alt=""><div class="card-body"><div class="rating">★ <%= c.rating %> <small>(<%= c.reviews %>)</small></div><h3><a href="/center/<%= c.id %>"><%= c.name %></a></h3><p class="muted">📍 <%= c.city %></p><a class="outline" href="/center/<%= c.id %>">View details</a></div></article><% }) %><% if(!centers.length){ %><div class="empty"><h2>No saved centers yet</h2><p>Open a training center and select Save center.</p></div><% } %></section><%- include('partials-foot') %>
