<%- include('partials-head',{title:'Create account'}) %><section class="auth"><div class="auth-card"><span class="eyebrow">JOIN TRAININGFINDER</span><h1>Create account</h1><p class="muted">Save institutes and keep your shortlist in one place.</p><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="/register"><label>Full name<input name="name" required placeholder="Your name"></label><label>Email<input type="email" name="email" required placeholder="you@example.com"></label><label>Password<input type="password" name="password" minlength="8" required placeholder="Minimum 8 characters"></label><button class="button full">Create account</button></form><p class="center-text">Already registered? <a href="/login">Sign in</a></p></div></section><%- include('partials-foot') %>
