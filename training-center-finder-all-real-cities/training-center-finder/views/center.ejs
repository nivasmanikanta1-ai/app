<%- include('partials-head',{title:center.name}) %><section class="detail-hero"><div><span class="eyebrow"><%= center.city.toUpperCase() %></span><h1><%= center.name %></h1><div class="big-rating">★ <%= center.rating %> <span>(<%= center.reviews %> reviews)</span></div><p><%= center.description %></p><p>📍 <%= center.address %></p><div class="actions"><% if(user){ %><form action="/favorite/<%= center.id %>" method="post"><button class="button"><%= favorite?'♥ Saved':'♡ Save center' %></button></form><% } else { %><a class="button" href="/login">Login to save</a><% } %><a class="outline" href="#courses">View courses</a></div></div><img src="<%= center.image_url %>" alt="<%= center.name %>"></section><section class="detail-grid"><div><section class="panel" id="courses"><h2>Courses offered</h2><div class="course-table"><div class="course-row head"><b>Course</b><b>Category</b><b>Duration</b><b>Fee</b><b>Mode</b></div><% courses.forEach(c=>{ %><div class="course-row"><span><strong><%= c.name %></strong></span><span><%= c.category %></span><span><%= c.duration %></span><span><%= c.fee %></span><span><%= c.mode %></span></div><% }) %></div></section><section class="panel"><h2>Facilities</h2><div class="chips"><% (center.facilities||[]).forEach(f=><span><%= f %></span>) %></div></section></div><aside><div class="panel contact"><h2>Institute information</h2><p>📞 <%= center.phone %></p><p>✉️ <%= center.email %></p><p>💰 <%= center.fee_range %></p><a href="<%= center.website %>" target="_blank" rel="noopener">Open institute / map →</a></div><div id="detailMap"></div><p class="map-note">Map pin shows the listed area; use “Open institute / map” for the exact address.</p></aside></section><script>window.centerLocation={lat:<%= center.latitude %>,lng:<%= center.longitude %>,name:<%- JSON.stringify(center.name) %>};</script><script src="/map.js"></script><%- include('partials-foot') %>
